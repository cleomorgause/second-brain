# ==============================================================================
# Second Brain - Configurações de Ambiente
# Copie este arquivo para .env e preencha com suas configurações:
# cp .env.example .env
# ==============================================================================

# Caminho para o cofre do Obsidian (relativo ou absoluto)
# O padrão './my_vault' cria e usa uma pasta local de desenvolvimento
VAULT_PATH=./my_vault

# Chaves de API dos Provedores de IA (Preencha ao menos uma)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Modelo de IA padrão a ser utilizado
# Exemplos com LiteLLM:
# - gemini/gemini-3.8-flash
# - gemini/gemini-2.5-pro
# - gpt-4o
# - gpt-4o-mini
# - claude-3-5-sonnet-20241022
DEFAULT_AI_MODEL=gemini/gemini-3.8-flash

# Configurações do Notion (necessário para a integração na Fase 2 / MVP)
NOTION_API_KEY=
NOTION_INBOX_DATABASE_ID=
